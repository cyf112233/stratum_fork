<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Stratum.Desktop.Controls"
        x:Class="Stratum.Desktop.Views.ConfirmWindow"
        Title="确认"
        Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Foreground="{DynamicResource WindowForegroundBrush}">
        <Border CornerRadius="12" Background="{DynamicResource WindowBackgroundBrush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
    <DockPanel>
        <controls:TitleBar DockPanel.Dock="Top" x:Name="HeaderBar" />
        <StackPanel Margin="22,14,22,18" Spacing="14">
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" Opacity="0.85" FontSize="13.5" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button Content="{DynamicResource Str.Cancel}" Click="OnCancelClicked" />
                <Button Content="{DynamicResource Str.Ok}" Classes="accent" Click="OnConfirmClicked"
                        IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </DockPanel>
        </Border>
</Window>
