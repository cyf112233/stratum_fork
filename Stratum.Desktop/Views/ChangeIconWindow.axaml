<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Stratum.Desktop.Controls"
        x:Class="Stratum.Desktop.Views.ChangeIconWindow"
        Title="{DynamicResource Str.ChooseIcon}"
        Width="580" Height="560"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Foreground="{DynamicResource WindowForegroundBrush}">
        <Border CornerRadius="12" Background="{DynamicResource WindowBackgroundBrush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
    <DockPanel>
        <controls:TitleBar DockPanel.Dock="Top" TitleText="{DynamicResource Str.ChooseIcon}" />
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="16,12,16,10">
            <TextBox x:Name="SearchBox" PlaceholderText="{DynamicResource Str.SearchIcon}" Width="220" />
            <Button Content="{DynamicResource Str.UploadCustomIcon}" Click="OnUploadCustomIconClicked" />
            <Button Content="{DynamicResource Str.Cancel}" Click="OnCancelClicked" HorizontalAlignment="Right" />
        </StackPanel>
        <ScrollViewer>
            <ItemsControl x:Name="IconsGrid" Margin="12,0,12,12">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:CompileBindings="False">
                        <Border Width="52" Height="52" CornerRadius="10"
                                Background="{DynamicResource IconCircleBrush}" Margin="4" Cursor="Hand"
                                PointerPressed="OnIconClicked" Tag="{Binding Key}">
                            <Image Source="{Binding Bitmap}" Width="28" Height="28" Stretch="Uniform" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
        </Border>
</Window>
